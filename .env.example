# MERIDIAN Grid — environment variables
# Copy this file to .env and fill in your values.
# .env is git-ignored; never commit your actual key.

# ENTSO-E Transparency Platform API key (free).
# Get yours: https://transparency.entsoe.eu → My Account → Security Token
# Or email transparency@entsoe.eu with subject "Restful API access".
ENTSOE_KEY=your_key_here

# Optional: override the default Flask port (default: 5002)
# PORT=5002

# Optional: override the data refresh interval in seconds (default: 1800)
# REFRESH_INTERVAL=1800
